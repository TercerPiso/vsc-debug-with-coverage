{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Extension",
            "type": "shell",
            "command": "npx tsc -p .",
            "problemMatcher": ["$tsc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Watch Extension",
            "type": "shell",
            "command": "npx tsc -p . --watch",
            "problemMatcher": ["$tsc-watch"],
            "isBackground": true,
            "group": {
                "kind": "build",
                "isDefault": false
            }
        }
    ]
}
